  var vn = v0 - vec3<f32>(0.0, P.gravity * P.dt, 0.0); var vo = v0;
  var cm = array<vec3<f32>, 3>(vec3<f32>(0.0), vec3<f32>(0.0), vec3<f32>(0.0));
  if (hasStorage(fcell)) {
