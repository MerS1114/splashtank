  let d = p - cols[k * 8u + 5u].xyz;
  let lp = vec3<f32>(dot(r0, d), dot(r1, d), dot(r2, d));
  let g = (lp - b.xyz) / b.w;
  let dims = a.yzw;
  let gc = clamp(g, vec3<f32>(0.0), dims - vec3<f32>(1.0001));
  let fl = floor(gc); let f = gc - fl;
