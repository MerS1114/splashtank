  var s = vec3<f32>(0.0); var L = P.ext2.x; var amp = 1.0; var norm = 0.0;
  let t = P.q8 * P.ext2.z; let oct = u32(clamp(P.ext2.y, 1.0, 5.0)); let e = 0.15;
  for (var o = 0u; o < oct; o++) {
