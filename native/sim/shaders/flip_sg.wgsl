  var p = pos[i].xyz; var v = vel[i].xyz; var foam = vel[i].w - 2.0;
  let n = u32(clamp(ceil(length(v) * P.dt / (0.5 * P.h)), 1.0, 32.0)); let dt = P.dt / f32(n);
  let kd = P.q4 * 1.54;
  for (var k = 0u; k < n; k++) {
    var gust = vec3<f32>(0.0);
