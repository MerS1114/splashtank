    let w = select(0.75, 0.25, o.x == 1) * select(0.75, 0.25, o.y == 1) * select(0.75, 0.25, o.z == 1);
    if (c == 0) { v += w * ep; continue; }
    let q = mgCell(l, pc + o * sd);
    if (q.t > 1.5) { v += w * ep; } else if (q.t > 0.5) { v += w * mg[q.e]; }
